<?xml version="1.0" encoding="utf-8"?>
<!-- Inverse surface keeps the selected destination visible in light, dark, and dynamic palettes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@android:color/transparent" />
    <item android:state_checked="true" android:color="?attr/colorSurfaceInverse" />
    <item android:color="@android:color/transparent" />
</selector>
